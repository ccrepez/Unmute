# Salin file ini menjadi .env lalu isi nilainya di laptop masing-masing.
# File .env TIDAK BOLEH di-push.

# Port server Express (Android memakai http://10.0.2.2:3000/api/)
PORT=3000

# Koneksi PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE?schema=public
DATABASE_URL="postgresql://postgres:PASSWORD_KAMU@localhost:5432/unmute?schema=public"

# Path ke file service account firebase-admin (dikirim lewat grup, jangan di-push)
# Path relatif dihitung dari folder backend/
FIREBASE_SERVICE_ACCOUNT_PATH="./unmute-dff57-firebase-adminsdk-xxxxx.json"
